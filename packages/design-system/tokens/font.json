{
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Geist Variable",
          "Geist",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "The one UI face. Identifiers, dates and numbers use it too. Geist Variable is the face fonts.css loads; Geist is the same family installed on the machine."
      },
      "heading": {
        "$value": [
          "Geist Variable",
          "Geist",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Same face as body today; a token so a theme may split them."
      },
      "code": {
        "$value": [
          "Geist Mono Variable",
          "Geist Mono",
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Code blocks and data previews only. Never UI text. Geist Mono Variable is the name the packaged mono face takes once fonts.css loads it."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "Body, cells, controls."
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, UI headings, emphasis inside body text."
      },
      "semibold": {
        "$value": 600,
        "$description": "Titles (a page's, a record's, a section's, a panel's) and a Stat's figure. Never running text."
      }
    },
    "letterSpacing": {
      "0": {
        "$value": "0em"
      },
      "100": {
        "$value": "-0.004em",
        "$description": "Smallest sizes."
      },
      "200": {
        "$value": "-0.008em",
        "$description": "Body sizes."
      },
      "300": {
        "$value": "-0.015em",
        "$description": "Headings up to 20px."
      },
      "400": {
        "$value": "-0.02em",
        "$description": "Display sizes."
      },
      "500": {
        "$value": "0.06em",
        "$description": "Uppercase micro labels: eyebrows, group headings."
      },
      "$type": "dimension"
    },
    "body": {
      "$type": "typography",
      "large": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.9375rem",
          "lineHeight": "1.375rem",
          "letterSpacing": "{font.letterSpacing.200}"
        },
        "$description": "Reading text and dialog body."
      },
      "small": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.75rem",
          "lineHeight": "1rem",
          "letterSpacing": "{font.letterSpacing.100}"
        },
        "$description": "Table headers, field labels, badges, KeyValue. Labels add font.weight.medium."
      },
      "xsmall": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.6875rem",
          "lineHeight": "0.875rem",
          "letterSpacing": "{font.letterSpacing.100}"
        },
        "$description": "Eyebrow, counts, metadata."
      },
      "default": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.8125rem",
          "lineHeight": "1.125rem",
          "letterSpacing": "{font.letterSpacing.200}"
        },
        "$description": "Controls, cells, tabs, inputs, menu items. The UI size: 13/18px at the browser's default text size. Every size and line height is in rem, so the reader's text-size setting reaches them."
      }
    },
    "heading": {
      "$type": "typography",
      "large": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.75rem",
          "lineHeight": "2.125rem",
          "letterSpacing": "{font.letterSpacing.400}"
        },
        "$description": "Display: a figure bigger than a Stat's, or the one title of a screen with nothing else on it (sign-in). Not a page or record title."
      },
      "medium": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.375rem",
          "lineHeight": "1.75rem",
          "letterSpacing": "{font.letterSpacing.400}"
        },
        "$description": "A Heading medium: a page title set without PageHeader. PageHeader.Title is font.heading.small at semibold."
      },
      "small": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "1.25rem",
          "lineHeight": "1.625rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "A section heading set with Heading; at semibold, the page and record title (PageHeader.Title) and a Stat's figure."
      },
      "xsmall": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "0.9375rem",
          "lineHeight": "1.375rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "Dialog and card titles."
      },
      "xxsmall": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "0.6875rem",
          "lineHeight": "0.875rem",
          "letterSpacing": "{font.letterSpacing.500}"
        },
        "$description": "Eyebrows, group headings and menu section labels. The component adds the uppercase."
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.code}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "0.75rem",
        "lineHeight": "1.125rem",
        "letterSpacing": "{font.letterSpacing.0}"
      },
      "$description": "Code blocks only."
    }
  }
}
