{
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Geist Variable",
          "Geist",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "The one UI face. Identifiers, dates and numbers use it too. Geist Variable is the face fonts.css loads; Geist is the same family installed on the machine."
      },
      "heading": {
        "$value": [
          "Geist Variable",
          "Geist",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Same face as body today; a token so a theme may split them."
      },
      "code": {
        "$value": [
          "Geist Mono",
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "Code blocks and data previews only. Never UI text. The package ships no mono face, so the stack names faces the machine has: Geist Mono or JetBrains Mono where installed, else the system monospace."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "Body, cells, controls."
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, UI headings, emphasis inside body text."
      },
      "semibold": {
        "$value": 600,
        "$description": "Titles (a page's, a record's, a section's, a panel's) and a Stat's figure. Never running text."
      }
    },
    "letterSpacing": {
      "0": {
        "$value": "0em"
      },
      "100": {
        "$value": "-0.004em",
        "$description": "Smallest sizes."
      },
      "200": {
        "$value": "-0.008em",
        "$description": "Body sizes."
      },
      "300": {
        "$value": "-0.015em",
        "$description": "Headings up to 20px."
      },
      "400": {
        "$value": "-0.02em",
        "$description": "Display sizes."
      },
      "500": {
        "$value": "0.06em",
        "$description": "Uppercase micro labels: eyebrows, group headings."
      },
      "$type": "dimension"
    },
    "body": {
      "$type": "typography",
      "large": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.9375rem",
          "lineHeight": "1.375rem",
          "letterSpacing": "{font.letterSpacing.200}"
        },
        "$description": "Reading text and dialog body."
      },
      "small": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.75rem",
          "lineHeight": "1rem",
          "letterSpacing": "{font.letterSpacing.100}"
        },
        "$description": "Table headers, field labels, badges, KeyValue. Labels add font.weight.medium."
      },
      "xsmall": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.6875rem",
          "lineHeight": "0.875rem",
          "letterSpacing": "{font.letterSpacing.100}"
        },
        "$description": "Eyebrow, counts, metadata."
      },
      "default": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "0.8125rem",
          "lineHeight": "1.125rem",
          "letterSpacing": "{font.letterSpacing.200}"
        },
        "$description": "Controls, cells, tabs, inputs, menu items. The UI size: 13/18px at the browser's default text size. Every size and line height is in rem, so the reader's text-size setting reaches them."
      }
    },
    "heading": {
      "$type": "typography",
      "display": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.75rem",
          "lineHeight": "2.125rem",
          "letterSpacing": "{font.letterSpacing.400}"
        },
        "$description": "Heading `display`: a figure bigger than a Stat's, or the one title of a screen with nothing else on it (sign-in), set as its h1. Never a page or record title."
      },
      "page": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.25rem",
          "lineHeight": "1.625rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "Heading `page`: the page and record title, which PageHeader.Title draws on a page and as a preview's record name, and a Stat's figure."
      },
      "overlay": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "0.9375rem",
          "lineHeight": "1.375rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "Heading `overlay`: an overlay's title, which DialogTitle, SheetTitle, AlertDialogTitle and DrawerTitle draw; a card's title and a group heading inside an overlay take it too."
      },
      "section": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "0.8125rem",
          "lineHeight": "1.125rem",
          "letterSpacing": "{font.letterSpacing.200}"
        },
        "$description": "Heading `section`: a section's title, which Section.Title draws: body size at semibold."
      },
      "large": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.75rem",
          "lineHeight": "2.125rem",
          "letterSpacing": "{font.letterSpacing.400}"
        },
        "$description": "Deprecated: font.heading.display, the same style. Kept for one version.",
        "$extensions": { "ledger": { "deprecated": "font.heading.display" } }
      },
      "medium": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.semibold}",
          "fontSize": "1.375rem",
          "lineHeight": "1.75rem",
          "letterSpacing": "{font.letterSpacing.400}"
        },
        "$description": "Deprecated: font.heading.page (20/26) for a page or record title. Kept for one version.",
        "$extensions": { "ledger": { "deprecated": "font.heading.page" } }
      },
      "small": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "1.25rem",
          "lineHeight": "1.625rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "Deprecated: font.heading.page (20/26 semibold) for a page or record title, font.heading.section for a section's title. Kept for one version.",
        "$extensions": { "ledger": { "deprecated": "font.heading.page" } }
      },
      "xsmall": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "0.9375rem",
          "lineHeight": "1.375rem",
          "letterSpacing": "{font.letterSpacing.300}"
        },
        "$description": "Deprecated: font.heading.overlay, the same style. Kept for one version.",
        "$extensions": { "ledger": { "deprecated": "font.heading.overlay" } }
      },
      "xxsmall": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "0.6875rem",
          "lineHeight": "0.875rem",
          "letterSpacing": "{font.letterSpacing.500}"
        },
        "$description": "Eyebrows, group headings and menu section labels. The component adds the uppercase."
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.code}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "0.75rem",
        "lineHeight": "1.125rem",
        "letterSpacing": "{font.letterSpacing.0}"
      },
      "$description": "Code blocks only."
    }
  }
}
