{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "Hover and press colour changes." },
      "medium": { "$value": "180ms", "$description": "Overlays entering and leaving." },
      "slow": {
        "$value": "400ms",
        "$description": "Marks arriving on a chart, and a drill-down redrawing it.",
        "$extensions": { "ledger": { "introduced": "0.5.0" } }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0.2, 1], "$description": "The one curve." }
    }
  }
}
