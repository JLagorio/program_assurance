{
  "name": "@ledger/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Ledger: tokens, primitives and components. DTCG source in tokens/, generated outputs in src/generated/.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cn": "./src/lib/cn.ts",
    "./ledger.css": "./src/styles/ledger.css",
    "./base.css": "./src/styles/base.css",
    "./reset.css": "./src/styles/reset.css",
    "./tokens.css": "./src/generated/tokens.css",
    "./tokens.json": "./src/generated/tokens.figma.json",
    "./eslint": "./eslint-plugin/index.js"
  },
  "scripts": {
    "build:tokens": "node build/tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:report": "CONTRAST_REPORT=1 node --test \"test/**/*.test.mjs\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "style-dictionary": "^5.5.2"
  },
  "files": [
    "src",
    "!src/stories",
    "!src/generated/docs.json",
    "tokens",
    "build",
    "eslint-plugin",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.0.0"
  }
}
